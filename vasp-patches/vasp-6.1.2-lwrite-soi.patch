-          END DO
+          IF (PRESENT(DLLMM)) THEN
+             DO I=0,1
+             DO J=0,1
+             DO M =1,2*LL+1
+             DO MP=1,2*LL+1
+                DLLMM(LMP+MP-1,LM+M-1,J+2*I+1)=DLLMM(LMP+MP-1,LM+M-1,J+2*I+1)+ &
+                SUM*LS(M,MP,I+2*J+1,LL)
