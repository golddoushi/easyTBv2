       REAL(q), ALLOCATABLE, PRIVATE, SAVE :: SPINORB_MATRIX_ELEMENTS(:,:,:)
       REAl(q), ALLOCATABLE, PRIVATE, SAVE :: SPINORB_ENERGY_PER_SITE(:)
+
+! LWRITE_SOI requests matrix elements of the orbital part of the PAW
+! spin-orbit operator between the scalar-relativistic Bloch states.
+! SOI_ORB_MATRIX(i,j,k,ion), k=1,2,3, stores the Cartesian x,y,z
+! projector-space matrices in eV.  These matrices are calculated from
+! the no-SOC potential and are never added to CDIJ.
+      LOGICAL, PUBLIC, SAVE :: LWRITE_SOI=.FALSE.
+      COMPLEX(q), ALLOCATABLE, PUBLIC, SAVE :: SOI_ORB_MATRIX(:,:,:,:)
       
       CONTAINS
+
+!*******************************************************************
+
+      SUBROUTINE INIT_SOI_ORB_MATRIX(LMDIM,NIONS)
+
+!*******************************************************************
+      IMPLICIT NONE
+      INTEGER LMDIM,NIONS
+
+      IF (ALLOCATED(SOI_ORB_MATRIX)) THEN
+         IF (SIZE(SOI_ORB_MATRIX,1)/=LMDIM .OR. &
+        &    SIZE(SOI_ORB_MATRIX,2)/=LMDIM .OR. &
+        &    SIZE(SOI_ORB_MATRIX,3)/=3 .OR. &
+        &    SIZE(SOI_ORB_MATRIX,4)/=NIONS) THEN
+            DEALLOCATE(SOI_ORB_MATRIX)
+         ENDIF
+      ENDIF
+      IF (.NOT.ALLOCATED(SOI_ORB_MATRIX)) &
+     &   ALLOCATE(SOI_ORB_MATRIX(LMDIM,LMDIM,3,NIONS))
+      SOI_ORB_MATRIX=(0._q,0._q)
+
+      END SUBROUTINE INIT_SOI_ORB_MATRIX
       
 !*******************************************************************
 
