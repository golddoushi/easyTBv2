+                  & DLLMM_ORB(LMP+MP-1,LM+M-1,J)+ &
+                  & SUM*(LS(M,MP,3,LL)+LS(M,MP,2,LL))/2._q
+                ELSE IF (J==2) THEN
+                   DLLMM_ORB(LMP+MP-1,LM+M-1,J)= &
+                  & DLLMM_ORB(LMP+MP-1,LM+M-1,J)+ &
+                  & SUM*(0._q,0.5_q)*(LS(M,MP,3,LL)-LS(M,MP,2,LL))
+                ELSE
+                   DLLMM_ORB(LMP+MP-1,LM+M-1,J)= &
+                  & DLLMM_ORB(LMP+MP-1,LM+M-1,J)+ &
