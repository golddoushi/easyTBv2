+     &   CALLMPI( M_sum_z(WDES%COMM,SOI_ORB_MATRIX,SIZE(SOI_ORB_MATRIX)) )
 
       CALLMPI( M_sum_d(WDES%COMM, DOUBLEC_AE, 1))
       CALLMPI( M_sum_d(WDES%COMM, DOUBLEC_PS, 1))
diff --git a/src/relativistic.F b/src/relativistic.F
